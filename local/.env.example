# Personal single-owner deployments may explicitly use durable filesystem persistence.
# Other production deployments use PostgreSQL.
ERRANDOS_DEPLOYMENT_PROFILE=personal
ERRANDOS_PERSISTENCE_MODE=filesystem
# Required when ERRANDOS_PERSISTENCE_MODE=postgres.
DATABASE_URL=postgresql://errandos:change-me@127.0.0.1/errandos
# Durable local state root. Keep outside git on an encrypted volume; directories/files are 0700/0600.
ERRANDOS_DATA_ROOT=/var/lib/errandos
ERRANDOS_PRINCIPAL_ID=local-hermes
# Generate a profile-reference secret of at least 32 bytes. Never commit it.
ERRANDOS_PROFILE_REF_SECRET=
# Used to self-mint and consume single-use capabilities in trusted COD mode.
ERRANDOS_APPROVAL_HMAC_SECRET=
# Owner-autonomous mode is restricted to Blinkit grocery + COD and is off by default.
ERRANDOS_TRUSTED_AUTONOMOUS_COD=false
# Owner-only raw confirmation/tracking/delivered image after verified commit; personal profile only.
ERRANDOS_OWNER_ORDER_EVIDENCE=false
# Provider page interaction is off by default.
ERRANDOS_LIVE_BROWSER_ACTIONS=false
# Final order/ride action has a separate gate and defaults false.
ERRANDOS_LIVE_COMMIT=false
ERRANDOS_BROWSER_HEADLESS=true
# Maximum time a phone/OTP browser challenge stays open.
ERRANDOS_LOGIN_SESSION_MS=600000
# Android Blinkit runs through a principal-isolated worker on the private network.
# The SSH account must force /opt/errandos/bin/android-worker-job in authorized_keys.
ERRANDOS_BLINKIT_EXECUTION=android
ERRANDOS_ANDROID_WORKER_SSH_HOST=errandos-android-worker.example.ts.net
ERRANDOS_ANDROID_WORKER_SSH_USER=errandos-worker-agent
ERRANDOS_ANDROID_WORKER_IDENTITY_FILE=/run/secrets/android-worker-key
ERRANDOS_ANDROID_WORKER_KNOWN_HOSTS_FILE=/run/secrets/android-worker-known-hosts
ERRANDOS_ANDROID_WORKER_COMMAND=/opt/errandos/bin/android-worker-job
ERRANDOS_RAPIDO_EXECUTION=android
# Rapido final ride requests have an additional provider-specific kill switch.
ERRANDOS_RAPIDO_LIVE_COMMIT=false
# Existing product search integration.
PRODUCT_SEARCH_BASE_URL=http://127.0.0.1:3001
PRODUCT_SEARCH_TIMEOUT_MS=40000

# Multilingual voice gateway. Keep these values server-side and out of browser bundles.
SARVAM_API_KEY=
SARVAM_API_BASE_URL=https://api.sarvam.ai
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_MODEL=hermes-agent

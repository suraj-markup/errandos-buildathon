# Keep the real value in .env.local. Never commit it or expose it to the phone client.
OPENAI_API_KEY=sk-your-server-managed-key
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_BOUNDED_CONTROL_MODEL=gpt-4.1-mini
SARVAM_API_KEY=your-sarvam-server-managed-key

# Appium runs locally on the Mac.
APPIUM_URL=http://127.0.0.1:4723

# Replace this with the serial shown by `adb devices -l`.
# For wireless ADB, this is commonly the phone's IP address and debug port.
ANDROID_DEVICE_UDID=192.168.1.100:5555

# Durable Workflow V2 repository location. This is configuration, not a
# feature flag; workflow rollback uses a prior release.
JALDI_PHONE_TASK_V2_STATE_PATH=
JALDI_LOG_CONTENT_V1=false
JALDI_SCREENSHOT_OBSERVATION_V1=false
JALDI_VISION_GROUNDING_V1=false
JALDI_REALTIME_SHADOW_V1=false
# Persistent text/image reasoning and validated tool proposals. Sarvam still owns speech.
JALDI_REALTIME_CONTROL_V1=false
JALDI_REALTIME_PHONE_TOOLS_V1=false
# Runs persisted V2-task reconciliation at server startup.

# Cost, lifetime, and fallback limits. These apply even when rollout flags are on.
JALDI_CONTROL_FALLBACK_ORDER=realtime_control,responses_control,semantic_only
JALDI_REALTIME_REASONING_EFFORT=low
JALDI_REALTIME_CONTEXT_TOKEN_LIMIT=8000
JALDI_REALTIME_MAX_SESSION_MS=900000
JALDI_REALTIME_RECONNECT_ATTEMPTS=2
JALDI_REALTIME_RECONNECT_BASE_DELAY_MS=500
JALDI_REALTIME_RECONNECT_MAX_DELAY_MS=2000
JALDI_SCREENSHOT_DETAIL=low
JALDI_SCREENSHOT_MAX_CAPTURES_PER_TASK=4
JALDI_SCREENSHOT_MAX_IMAGE_BYTES=1500000
JALDI_SCREENSHOT_MIN_CAPTURE_INTERVAL_MS=5000
JALDI_SCREENSHOT_GROUNDING_TIMEOUT_MS=3500
JALDI_SCREENSHOT_TASK_RETENTION_MS=900000
